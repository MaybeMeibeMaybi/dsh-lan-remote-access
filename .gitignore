# ---- Node / npm ----
node_modules/
npm-debug.log*
pnpm-debug.log*
package-lock.json
pnpm-lock.yaml

# ---- Logs and runtime state ----
*.log
logs/

# ---- Secrets: never commit credentials ----
.env
.env.*
*.pem
*.key
credential*

# ---- Editor / OS ----
.vscode/
.idea/
Thumbs.db
desktop.ini
*.swp

# ---- Local scratch ----
tmp/
temp/
*.bak-*

# ---- secrets / credentials (never commit) ----
secrets/
*register-key*
*.pfx
*.p12
ca-key.pem
gateway.env
# CA certs for phone install are safe to publish, but keep local copies out:
!ca-for-phone/*.cer
!ca-for-phone/*.crt
